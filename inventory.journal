; ============================================================
; inventory.journal — hledger file for tracking a small product inventory
; Full pipeline:
;   Supplier -> InTransit -> Inbound dock -> Bin (storage location)
;   Bin -> Outbound staging -> Shipped -> Delivered/Invoiced (AR) -> Paid
; ============================================================
; Run `hledger -f inventory.journal ...` or set:
;   export LEDGER_FILE=inventory.journal
; ============================================================

; ---- Commodity formats ----
; Your money commodity: adjust EUR to whatever you use.
commodity 1000.00 EUR

; One commodity per product you stock. Rename/add as needed.
commodity 1. WIDGET
commodity 1. GADGET

; ---- Account declarations ----
; Declaring accounts lets hledger warn you about typos (`hledger check accounts`).
; Bin accounts: only declare the ones you actually use — you don't need to
; pre-declare every possible bin in the warehouse, just add a line as new
; bins come into use.
account Assets:Bank:Checking
account Assets:Accounts Receivable
account Assets:Accounts Receivable:CustomerA
account Assets:Accounts Receivable:CustomerB
account Liabilities:Accounts Payable
account Liabilities:Accounts Payable:Supplier ABC
account Liabilities:Accounts Payable:Supplier XYZ



; Ordered from supplier, not yet arrived
account Assets:Inventory:InTransit

; Arrived at the warehouse dock, not yet put away
account Assets:Inventory:Warehouse:Inbound


; Put away in a specific bin location — this is where "where is it stored" lives
account Assets:Inventory:Warehouse:Bin:A1
account Assets:Inventory:Warehouse:Bin:B1
account Assets:Inventory:Warehouse:Bin:B2

; Picked from a bin, staged for shipment, not yet left the building
account Assets:Inventory:Warehouse:Outbound

; Left the warehouse, en route to a customer, not yet delivered/invoiced
account Assets:Inventory:Shipped

account Equity:Opening Balances
account Income:Sales
account Expenses:Cost of Goods Sold

; ============================================================
; Example transactions — replace with your real data
; ============================================================

2026-01-01 Opening balances
    Assets:Bank:Checking                                             1000.00 EUR
    Equity:Opening Balances

; ---- Purchasing: order (net-30) -> in transit -> inbound -> put away in bin(s) ----

2026-01-03 Order widgets from supplier, net-30 terms ; order:123
    Assets:Inventory:InTransit                              50 WIDGET @ 4.00 EUR
    Liabilities:Accounts Payable:Supplier XYZ

2026-01-08 Widgets arrive at warehouse inbound dock ; order:123
    Assets:Inventory:Warehouse:Inbound                      50 WIDGET @ 4.00 EUR
    Assets:Inventory:InTransit                             -50 WIDGET @ 4.00 EUR

2026-01-08 Put away widgets in bin A1
    Assets:Inventory:Warehouse:Bin:A1                       50 WIDGET @ 4.00 EUR
    Assets:Inventory:Warehouse:Inbound                     -50 WIDGET @ 4.00 EUR

2026-02-02 Pay supplier invoice for widgets ; order:123
    Liabilities:Accounts Payable:Supplier XYZ                         200.00 EUR
    Assets:Bank:Checking

2026-01-04 Order gadgets from supplier, net-30 terms ; order:456
    Assets:Inventory:InTransit                             20 GADGET @ 10.00 EUR
    Liabilities:Accounts Payable:Supplier ABC

2026-01-09 Gadgets arrive at warehouse inbound dock ; order:456
    Assets:Inventory:Warehouse:Inbound                     20 GADGET @ 10.00 EUR
    Assets:Inventory:InTransit                            -20 GADGET @ 10.00 EUR

; Split across two bins — one transaction, three postings, still balances
2026-01-09 Put away gadgets in bins B1 and B2
    Assets:Inventory:Warehouse:Bin:B1                      12 GADGET @ 10.00 EUR
    Assets:Inventory:Warehouse:Bin:B2                       8 GADGET @ 10.00 EUR
    Assets:Inventory:Warehouse:Inbound                    -20 GADGET @ 10.00 EUR

2026-02-03 Pay supplier invoice for gadgets ; order:456
    Liabilities:Accounts Payable:Supplier ABC                         200.00 EUR
    Assets:Bank:Checking

; ---- Selling: pick from bin -> outbound staging -> ship -> deliver/invoice -> paid ----

2026-01-10 Pick 10 widgets from bin A1 for an order
    Assets:Inventory:Warehouse:Outbound                     10 WIDGET @ 4.00 EUR
    Assets:Inventory:Warehouse:Bin:A1                      -10 WIDGET @ 4.00 EUR

2026-01-11 Ship 10 widgets to customer
    Assets:Inventory:Shipped                                10 WIDGET @ 4.00 EUR
    Assets:Inventory:Warehouse:Outbound                    -10 WIDGET @ 4.00 EUR

2026-01-13 Widgets delivered, invoice issued to customer
    Assets:Accounts Receivable                                         80.00 EUR
    Income:Sales
    Expenses:Cost of Goods Sold                             10 WIDGET @ 4.00 EUR
    Assets:Inventory:Shipped                               -10 WIDGET @ 4.00 EUR

2026-01-20 Customer pays widget invoice
    Assets:Bank:Checking                                               80.00 EUR
    Assets:Accounts Receivable                                        -80.00 EUR

2026-01-15 Pick 5 gadgets from bin B1 for an order
    Assets:Inventory:Warehouse:Outbound                     5 GADGET @ 10.00 EUR
    Assets:Inventory:Warehouse:Bin:B1                      -5 GADGET @ 10.00 EUR

2026-01-16 Ship 5 gadgets to customer
    Assets:Inventory:Shipped                                5 GADGET @ 10.00 EUR
    Assets:Inventory:Warehouse:Outbound                    -5 GADGET @ 10.00 EUR

2026-01-18 Gadgets delivered, invoice issued to customer
    Assets:Accounts Receivable                                         75.00 EUR
    Income:Sales
    Expenses:Cost of Goods Sold                             5 GADGET @ 10.00 EUR
    Assets:Inventory:Shipped                               -5 GADGET @ 10.00 EUR

2026-01-25 Customer pays gadget invoice
    Assets:Bank:Checking                                               75.00 EUR
    Assets:Accounts Receivable                                        -75.00 EUR
